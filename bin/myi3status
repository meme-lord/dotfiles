#!/usr/bin/env bash

# This was made using code from i3status/contrib/any_position_wrapper.sh
# It adds an entry to the i3status that gives the number of the next unused workspace
# Needs jq installed

function update_holder {
  local instance="$1"
  local replacement="$2"
  echo "$json_array" | jq --argjson arg_j "$replacement" "(.[] | (select(.instance==\"$instance\"))) |= \$arg_j"
}

function update_first_empty_ws {
	local first_empty_ws=`comm -23 <(seq 10) <(i3-msg -t get_workspaces | jq '.[].num' | sort -h) 2>/dev/null | head -n 1`
	local json="{ \"full_text\": \"Empty WS: $first_empty_ws\" }"
	json_array=$(update_holder empty_ws "$json")
}

# Shows active WireGuard interfaces; empty full_text makes i3bar hide the block
function update_wireguard {
	local wg_ifaces=`ip -br link show type wireguard 2>/dev/null | awk '{print $1}' | paste -sd,`
	local json="{ \"full_text\": \"\" }"
	if [ -n "$wg_ifaces" ]; then
		json="{ \"full_text\": \"VPN: $wg_ifaces\", \"color\": \"#00FF00\" }"
	fi
	json_array=$(update_holder wireguard "$json")
}

i3status | (read line; echo "$line"; read line ; echo "$line" ; prefix="" ; while true
do
  read line
  json_array="$(echo $line | sed -e 's/^,//')"
  update_first_empty_ws
  update_wireguard
  echo "$prefix$json_array"
  prefix=","
done)
